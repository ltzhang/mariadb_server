[mysqld]
# Network settings
port=13306
socket=/tmp/mariadb_kvt_test/mysql.sock
bind-address=127.0.0.1
skip-networking=0

# File locations
pid-file=/tmp/mariadb_kvt_test/mariadb.pid
log-error=/tmp/mariadb_kvt_test/mariadb.log
datadir=/tmp/mariadb_kvt_test/data
tmpdir=/tmp/mariadb_kvt_test

# Performance settings for testing
key_buffer_size=16M
max_allowed_packet=16M
thread_stack=256K
thread_cache_size=8
max_connections=100

# InnoDB settings (minimal, since we're using KVT)
innodb_buffer_pool_size=64M
innodb_log_file_size=16M
innodb_flush_method=O_DIRECT
innodb_file_per_table=1

# Plugin settings
plugin-dir=/home/lintaoz/work/mariadb/build_kvt/storage/kvtstore
plugin-maturity=experimental

# KVT Storage Engine
# Load after initialization  
# default-storage-engine=KVT  
# plugin-load-add=ha_kvt.so

# Security settings for testing (disable for easier testing)
skip-grant-tables=1

# Logging and debugging
log-warnings=2
general_log=1
general_log_file=/tmp/mariadb_kvt_test/general.log
slow_query_log=1
slow_query_log_file=/tmp/mariadb_kvt_test/slow.log
long_query_time=1

# Character set
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci

[mysql]
socket=/tmp/mariadb_kvt_test/mysql.sock
port=13306
default-character-set=utf8mb4

[client]
socket=/tmp/mariadb_kvt_test/mysql.sock
port=13306
default-character-set=utf8mb4