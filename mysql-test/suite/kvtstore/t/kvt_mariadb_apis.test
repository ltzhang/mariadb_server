# Test MariaDB-specific KVT APIs for pushdown operations

--source include/have_kvt.inc

--echo # ========================================
--echo # Test 1: Filter Pushdown with Predefined APIs
--echo # ========================================

CREATE TABLE t_filter (
    id INT PRIMARY KEY,
    name VARCHAR(50),
    age INT,
    salary DECIMAL(10,2),
    department VARCHAR(30),
    active BOOLEAN,
    INDEX idx_age (age),
    INDEX idx_dept (department)
) ENGINE=KVT;

# Insert test data
INSERT INTO t_filter VALUES 
    (1, 'Alice', 25, 50000.00, 'Engineering', TRUE),
    (2, 'Bob', 30, 60000.00, 'Sales', TRUE),
    (3, 'Charlie', 25, 55000.00, 'Engineering', FALSE),
    (4, 'David', 35, 70000.00, 'Management', TRUE),
    (5, 'Eve', 30, 65000.00, 'Sales', TRUE),
    (6, 'Frank', 28, 58000.00, 'Engineering', TRUE),
    (7, 'Grace', 40, 80000.00, 'Management', TRUE),
    (8, 'Henry', 35, 72000.00, 'HR', FALSE),
    (9, 'Iris', 27, 54000.00, 'Engineering', TRUE),
    (10, 'Jack', 32, 68000.00, 'Sales', FALSE);

--echo # Test equality filter (kvt_filter_eq)
SELECT id, name FROM t_filter WHERE age = 30;
SELECT id, name FROM t_filter WHERE department = 'Engineering';

--echo # Test range filter (kvt_filter_range)
SELECT id, name, salary FROM t_filter WHERE salary > 60000;
SELECT id, name, age FROM t_filter WHERE age >= 30 AND age <= 35;

--echo # Test IN filter (kvt_filter_in)
SELECT id, name FROM t_filter WHERE department IN ('Sales', 'Engineering');
SELECT id, name FROM t_filter WHERE age IN (25, 30, 35);

--echo # Test BETWEEN filter (kvt_filter_between)
SELECT id, name, salary FROM t_filter WHERE salary BETWEEN 55000 AND 70000;
SELECT id, name FROM t_filter WHERE age BETWEEN 28 AND 35;

--echo # Test LIKE filter (kvt_filter_like)
SELECT id, name FROM t_filter WHERE name LIKE 'A%';
SELECT id, name FROM t_filter WHERE department LIKE '%ing%';

--echo # Test composite filter (kvt_filter_composite)
SELECT id, name FROM t_filter WHERE age = 30 AND department = 'Sales';
SELECT id, name FROM t_filter WHERE (age < 30 OR salary > 70000) AND active = TRUE;

--echo # Test NULL handling
INSERT INTO t_filter VALUES (11, NULL, NULL, NULL, NULL, NULL);
SELECT id FROM t_filter WHERE name IS NULL;
SELECT id FROM t_filter WHERE age IS NOT NULL;

--echo # ========================================
--echo # Test 2: Aggregation Pushdown
--echo # ========================================

CREATE TABLE t_agg (
    id INT PRIMARY KEY,
    category VARCHAR(20),
    value INT,
    amount DECIMAL(10,2),
    quantity INT,
    INDEX idx_category (category)
) ENGINE=KVT;

INSERT INTO t_agg VALUES 
    (1, 'A', 100, 1000.00, 10),
    (2, 'B', 200, 2000.00, 20),
    (3, 'A', 150, 1500.00, 15),
    (4, 'C', 300, 3000.00, 30),
    (5, 'B', 250, 2500.00, 25),
    (6, 'A', 120, 1200.00, 12),
    (7, 'C', 350, 3500.00, 35),
    (8, 'B', 220, 2200.00, 22),
    (9, 'A', 180, 1800.00, 18),
    (10, 'C', 320, 3200.00, 32);

--echo # Test COUNT (kvt_aggregate_count)
SELECT COUNT(*) FROM t_agg;
SELECT COUNT(value) FROM t_agg;
SELECT COUNT(*) FROM t_agg WHERE category = 'A';

--echo # Test SUM (kvt_aggregate_sum)
SELECT SUM(value) FROM t_agg;
SELECT SUM(amount) FROM t_agg WHERE category = 'B';
SELECT SUM(quantity) FROM t_agg WHERE value > 200;

--echo # Test MIN/MAX (kvt_aggregate_min_max)
SELECT MIN(value), MAX(value) FROM t_agg;
SELECT MIN(amount), MAX(amount) FROM t_agg WHERE category = 'A';

--echo # Test AVG (kvt_aggregate_avg)
SELECT AVG(value) FROM t_agg;
SELECT AVG(amount) FROM t_agg WHERE category = 'C';

--echo # Test GROUP BY (kvt_aggregate_group_by)
SELECT category, COUNT(*), SUM(value), AVG(amount) 
FROM t_agg 
GROUP BY category
ORDER BY category;

SELECT category, MIN(value), MAX(value)
FROM t_agg
WHERE quantity > 15
GROUP BY category
HAVING MAX(value) > 200
ORDER BY category;

--echo # Test multiple aggregations (kvt_aggregate_multi)
SELECT 
    COUNT(*) as total_rows,
    SUM(value) as sum_value,
    AVG(amount) as avg_amount,
    MIN(quantity) as min_qty,
    MAX(quantity) as max_qty
FROM t_agg
WHERE value >= 150;

--echo # ========================================
--echo # Test 3: Atomic Operations
--echo # ========================================

CREATE TABLE t_atomic (
    id INT PRIMARY KEY,
    counter INT DEFAULT 0,
    total BIGINT DEFAULT 0,
    message VARCHAR(100),
    version INT DEFAULT 1
) ENGINE=KVT;

INSERT INTO t_atomic VALUES 
    (1, 100, 1000, 'First', 1),
    (2, 200, 2000, 'Second', 1),
    (3, 300, 3000, 'Third', 1);

--echo # Test atomic increment (kvt_atomic_increment)
UPDATE t_atomic SET counter = counter + 1 WHERE id = 1;
UPDATE t_atomic SET total = total + 100 WHERE id = 2;
UPDATE t_atomic SET counter = counter - 50 WHERE id = 3;

SELECT * FROM t_atomic ORDER BY id;

--echo # Test atomic compare-and-swap (kvt_atomic_cas)
# This would be a special UPDATE syntax - simulated here
UPDATE t_atomic SET version = 2 WHERE id = 1 AND version = 1;
UPDATE t_atomic SET version = 3 WHERE id = 1 AND version = 1;  # Should fail/no effect

SELECT id, version FROM t_atomic ORDER BY id;

--echo # Test conditional update (kvt_atomic_update_if)
UPDATE t_atomic SET message = 'Updated' WHERE counter > 100;
SELECT id, message FROM t_atomic ORDER BY id;

--echo # Test string append (kvt_atomic_append)
# Simulated - would need special syntax
UPDATE t_atomic SET message = CONCAT(message, ' - Modified') WHERE id = 2;
SELECT id, message FROM t_atomic WHERE id = 2;

--echo # ========================================
--echo # Test 4: Batch Operations
--echo # ========================================

CREATE TABLE t_batch (
    id INT PRIMARY KEY,
    data VARCHAR(50),
    status INT DEFAULT 0
) ENGINE=KVT;

--echo # Test batch insert (kvt_batch_insert)
START TRANSACTION;
INSERT INTO t_batch VALUES 
    (1, 'Data1', 1),
    (2, 'Data2', 1),
    (3, 'Data3', 1),
    (4, 'Data4', 1),
    (5, 'Data5', 1),
    (6, 'Data6', 1),
    (7, 'Data7', 1),
    (8, 'Data8', 1),
    (9, 'Data9', 1),
    (10, 'Data10', 1);
COMMIT;

SELECT COUNT(*) FROM t_batch;

--echo # Test batch update (kvt_batch_update)
UPDATE t_batch SET status = 2 WHERE status = 1;
SELECT COUNT(*) FROM t_batch WHERE status = 2;

--echo # Test batch delete (kvt_batch_delete)
DELETE FROM t_batch WHERE id > 5;
SELECT COUNT(*) FROM t_batch;

--echo # Test UPSERT (kvt_upsert)
# MariaDB doesn't have UPSERT, but INSERT ... ON DUPLICATE KEY UPDATE
INSERT INTO t_batch VALUES (1, 'Updated1', 3)
ON DUPLICATE KEY UPDATE data = 'Updated1', status = 3;

INSERT INTO t_batch VALUES (11, 'New11', 1)
ON DUPLICATE KEY UPDATE data = 'New11', status = 1;

SELECT * FROM t_batch WHERE id IN (1, 11) ORDER BY id;

--echo # ========================================
--echo # Test 5: Projection and Index-Only Scan
--echo # ========================================

CREATE TABLE t_projection (
    id INT PRIMARY KEY,
    col1 VARCHAR(20),
    col2 VARCHAR(20),
    col3 VARCHAR(20),
    col4 VARCHAR(20),
    col5 TEXT,
    INDEX idx_covering (id, col1, col2)
) ENGINE=KVT;

INSERT INTO t_projection VALUES 
    (1, 'A1', 'B1', 'C1', 'D1', REPEAT('Long text 1 ', 100)),
    (2, 'A2', 'B2', 'C2', 'D2', REPEAT('Long text 2 ', 100)),
    (3, 'A3', 'B3', 'C3', 'D3', REPEAT('Long text 3 ', 100)),
    (4, 'A4', 'B4', 'C4', 'D4', REPEAT('Long text 4 ', 100)),
    (5, 'A5', 'B5', 'C5', 'D5', REPEAT('Long text 5 ', 100));

--echo # Test projection (kvt_project_columns)
SELECT id, col1, col2 FROM t_projection WHERE id <= 3;

--echo # Test index-only scan (kvt_index_only_scan)
EXPLAIN SELECT id, col1, col2 FROM t_projection WHERE id BETWEEN 2 AND 4;
SELECT id, col1, col2 FROM t_projection WHERE id BETWEEN 2 AND 4;

--echo # ========================================
--echo # Test 6: Complex Queries with Multiple Pushdowns
--echo # ========================================

CREATE TABLE t_complex (
    id INT PRIMARY KEY,
    user_id INT,
    product_id INT,
    order_date DATE,
    quantity INT,
    price DECIMAL(10,2),
    status VARCHAR(20),
    INDEX idx_user (user_id),
    INDEX idx_product (product_id),
    INDEX idx_date (order_date)
) ENGINE=KVT;

INSERT INTO t_complex VALUES 
    (1, 101, 201, '2025-01-01', 2, 100.00, 'completed'),
    (2, 102, 202, '2025-01-02', 1, 200.00, 'completed'),
    (3, 101, 203, '2025-01-03', 3, 150.00, 'pending'),
    (4, 103, 201, '2025-01-04', 2, 100.00, 'completed'),
    (5, 102, 204, '2025-01-05', 1, 300.00, 'cancelled'),
    (6, 101, 202, '2025-01-06', 4, 200.00, 'completed'),
    (7, 104, 203, '2025-01-07', 2, 150.00, 'completed'),
    (8, 103, 204, '2025-01-08', 1, 300.00, 'pending'),
    (9, 102, 201, '2025-01-09', 3, 100.00, 'completed'),
    (10, 101, 205, '2025-01-10', 2, 250.00, 'completed');

--echo # Complex filter with aggregation
SELECT 
    user_id,
    COUNT(*) as order_count,
    SUM(quantity * price) as total_value,
    AVG(quantity) as avg_quantity
FROM t_complex
WHERE status = 'completed' 
    AND order_date >= '2025-01-01'
    AND order_date <= '2025-01-10'
GROUP BY user_id
HAVING total_value > 300
ORDER BY total_value DESC;

--echo # Subquery simulation (semi-join)
SELECT DISTINCT user_id 
FROM t_complex 
WHERE product_id IN (
    SELECT product_id 
    FROM t_complex 
    WHERE quantity > 2
);

