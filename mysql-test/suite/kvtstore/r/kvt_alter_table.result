# Test ALTER TABLE functionality in KVT storage engine
# ========================================
# Test 1: Basic ALTER TABLE Operations
# ========================================
CREATE TABLE t1 (
id INT PRIMARY KEY,
name VARCHAR(50),
age INT,
email VARCHAR(100)
) ENGINE=KVT;
INSERT INTO t1 VALUES 
(1, 'Alice', 25, 'alice@example.com'),
(2, 'Bob', 30, 'bob@example.com'),
(3, 'Charlie', 35, 'charlie@example.com');
# Test ADD COLUMN (instant operation)
ALTER TABLE t1 ADD COLUMN phone VARCHAR(20) DEFAULT '';
SELECT * FROM t1 ORDER BY id;
id	name	age	email	phone
1	Alice	25	alice@example.com	
2	Bob	30	bob@example.com	
3	Charlie	35	charlie@example.com	
# Test ADD COLUMN with position
ALTER TABLE t1 ADD COLUMN city VARCHAR(50) DEFAULT 'Unknown' AFTER name;
DESC t1;
Field	Type	Null	Key	Default	Extra
id	int(11)	NO	PRI	NULL	
name	varchar(50)	YES		NULL	
city	varchar(50)	YES		Unknown	
age	int(11)	YES		NULL	
email	varchar(100)	YES		NULL	
phone	varchar(20)	YES			
SELECT * FROM t1 ORDER BY id;
id	name	city	age	email	phone
1	Alice	Unknown	25	alice@example.com	
2	Bob	Unknown	30	bob@example.com	
3	Charlie	Unknown	35	charlie@example.com	
# Test DROP COLUMN (instant operation)
ALTER TABLE t1 DROP COLUMN age;
DESC t1;
Field	Type	Null	Key	Default	Extra
id	int(11)	NO	PRI	NULL	
name	varchar(50)	YES		NULL	
city	varchar(50)	YES		Unknown	
email	varchar(100)	YES		NULL	
phone	varchar(20)	YES			
SELECT * FROM t1 ORDER BY id;
id	name	city	email	phone
1	Alice	Unknown	alice@example.com	
2	Bob	Unknown	bob@example.com	
3	Charlie	Unknown	charlie@example.com	
# Test RENAME COLUMN (instant operation)
ALTER TABLE t1 RENAME COLUMN email TO email_address;
DESC t1;
Field	Type	Null	Key	Default	Extra
id	int(11)	NO	PRI	NULL	
name	varchar(50)	YES		NULL	
city	varchar(50)	YES		Unknown	
email_address	varchar(100)	YES		NULL	
phone	varchar(20)	YES			
SELECT * FROM t1 ORDER BY id;
id	name	city	email_address	phone
1	Alice	Unknown	alice@example.com	
2	Bob	Unknown	bob@example.com	
3	Charlie	Unknown	charlie@example.com	
# Test MODIFY COLUMN type
ALTER TABLE t1 MODIFY COLUMN phone VARCHAR(30);
DESC t1;
Field	Type	Null	Key	Default	Extra
id	int(11)	NO	PRI	NULL	
name	varchar(50)	YES		NULL	
city	varchar(50)	YES		Unknown	
email_address	varchar(100)	YES		NULL	
phone	varchar(30)	YES		NULL	
# Test CHANGE COLUMN (rename and modify)
ALTER TABLE t1 CHANGE COLUMN city location VARCHAR(100) DEFAULT 'N/A';
DESC t1;
Field	Type	Null	Key	Default	Extra
id	int(11)	NO	PRI	NULL	
name	varchar(50)	YES		NULL	
location	varchar(100)	YES		N/A	
email_address	varchar(100)	YES		NULL	
phone	varchar(30)	YES		NULL	
SELECT * FROM t1 ORDER BY id;
id	name	location	email_address	phone
1	Alice	Unknown	alice@example.com	
2	Bob	Unknown	bob@example.com	
3	Charlie	Unknown	charlie@example.com	
# ========================================
# Test 2: ALTER TABLE with Indexes
# ========================================
CREATE TABLE t2 (
id INT PRIMARY KEY,
col1 INT,
col2 VARCHAR(50),
col3 INT,
col4 VARCHAR(50)
) ENGINE=KVT;
INSERT INTO t2 VALUES 
(1, 100, 'data1', 10, 'text1'),
(2, 200, 'data2', 20, 'text2'),
(3, 300, 'data3', 30, 'text3'),
(4, 400, 'data4', 40, 'text4'),
(5, 500, 'data5', 50, 'text5');
# Test ADD INDEX (online operation)
ALTER TABLE t2 ADD INDEX idx_col1 (col1);
SHOW CREATE TABLE t2;
Table	Create Table
t2	CREATE TABLE `t2` (
  `id` int(11) NOT NULL,
  `col1` int(11) DEFAULT NULL,
  `col2` varchar(50) DEFAULT NULL,
  `col3` int(11) DEFAULT NULL,
  `col4` varchar(50) DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_col1` (`col1`)
) ENGINE=KVT DEFAULT CHARSET=latin1
# Test ADD UNIQUE INDEX
ALTER TABLE t2 ADD UNIQUE INDEX uk_col3 (col3);
SHOW CREATE TABLE t2;
Table	Create Table
t2	CREATE TABLE `t2` (
  `id` int(11) NOT NULL,
  `col1` int(11) DEFAULT NULL,
  `col2` varchar(50) DEFAULT NULL,
  `col3` int(11) DEFAULT NULL,
  `col4` varchar(50) DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_col1` (`col1`),
  UNIQUE KEY `uk_col3` (`col3`)
) ENGINE=KVT DEFAULT CHARSET=latin1
# Test ADD composite INDEX
ALTER TABLE t2 ADD INDEX idx_composite (col2, col4);
SHOW CREATE TABLE t2;
Table	Create Table
t2	CREATE TABLE `t2` (
  `id` int(11) NOT NULL,
  `col1` int(11) DEFAULT NULL,
  `col2` varchar(50) DEFAULT NULL,
  `col3` int(11) DEFAULT NULL,
  `col4` varchar(50) DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_col1` (`col1`),
  UNIQUE KEY `uk_col3` (`col3`),
  KEY `idx_composite` (`col2`,`col4`)
) ENGINE=KVT DEFAULT CHARSET=latin1
# Verify indexes work
SELECT * FROM t2 WHERE col1 = 300;
id	col1	col2	col3	col4
3	300	data3	30	text3
SELECT * FROM t2 WHERE col3 = 20;
id	col1	col2	col3	col4
2	200	data2	20	text2
SELECT * FROM t2 WHERE col2 = 'data3' AND col4 = 'text3';
id	col1	col2	col3	col4
3	300	data3	30	text3
# Test DROP INDEX (instant operation)
ALTER TABLE t2 DROP INDEX idx_col1;
SHOW CREATE TABLE t2;
Table	Create Table
t2	CREATE TABLE `t2` (
  `id` int(11) NOT NULL,
  `col1` int(11) DEFAULT NULL,
  `col2` varchar(50) DEFAULT NULL,
  `col3` int(11) DEFAULT NULL,
  `col4` varchar(50) DEFAULT NULL,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_col3` (`col3`),
  KEY `idx_composite` (`col2`,`col4`)
) ENGINE=KVT DEFAULT CHARSET=latin1
# Test ADD PRIMARY KEY (on table without primary key)
CREATE TABLE t3 (
id INT NOT NULL,
data VARCHAR(50)
) ENGINE=KVT;
INSERT INTO t3 VALUES (1, 'row1'), (2, 'row2'), (3, 'row3');
ALTER TABLE t3 ADD PRIMARY KEY (id);
SHOW CREATE TABLE t3;
Table	Create Table
t3	CREATE TABLE `t3` (
  `id` int(11) NOT NULL,
  `data` varchar(50) DEFAULT NULL,
  PRIMARY KEY (`id`)
) ENGINE=KVT DEFAULT CHARSET=latin1
# ========================================
# Test 3: ALTER TABLE with Constraints
# ========================================
CREATE TABLE t4 (
id INT PRIMARY KEY,
value INT,
status VARCHAR(20)
) ENGINE=KVT;
INSERT INTO t4 VALUES (1, 100, 'active'), (2, 200, 'inactive'), (3, 300, 'active');
# Test ADD UNIQUE constraint
ALTER TABLE t4 ADD UNIQUE (value);
# Verify unique constraint works
INSERT INTO t4 VALUES (4, 100, 'test');
ERROR 23000: Duplicate entry '100' for key 'value'
# Test ADD CHECK constraint (if supported)
# Test CHANGE DEFAULT
ALTER TABLE t4 ALTER COLUMN status SET DEFAULT 'pending';
DESC t4;
Field	Type	Null	Key	Default	Extra
id	int(11)	NO	PRI	NULL	
value	int(11)	YES	UNI	NULL	
status	varchar(20)	YES		pending	
INSERT INTO t4 (id, value) VALUES (5, 500);
SELECT * FROM t4 WHERE id = 5;
id	value	status
5	500	pending
# ========================================
# Test 4: Online ALTER TABLE
# ========================================
CREATE TABLE t5 (
id INT PRIMARY KEY,
data VARCHAR(100)
) ENGINE=KVT;
INSERT INTO t5 VALUES (1, 'initial1'), (2, 'initial2'), (3, 'initial3');
# Test ADD INDEX with ALGORITHM=INPLACE
ALTER TABLE t5 ADD INDEX idx_data (data), ALGORITHM=INPLACE, LOCK=NONE;
SHOW CREATE TABLE t5;
Table	Create Table
t5	CREATE TABLE `t5` (
  `id` int(11) NOT NULL,
  `data` varchar(100) DEFAULT NULL,
  PRIMARY KEY (`id`),
  KEY `idx_data` (`data`)
) ENGINE=KVT DEFAULT CHARSET=latin1
# Test ADD COLUMN with ALGORITHM=INSTANT
ALTER TABLE t5 ADD COLUMN created TIMESTAMP DEFAULT CURRENT_TIMESTAMP, ALGORITHM=INSTANT;
DESC t5;
Field	Type	Null	Key	Default	Extra
id	int(11)	NO	PRI	NULL	
data	varchar(100)	YES	MUL	NULL	
created	timestamp	NO		CURRENT_TIMESTAMP	on update CURRENT_TIMESTAMP
# ========================================
# Test 5: Complex ALTER Operations
# ========================================
CREATE TABLE t6 (
id INT PRIMARY KEY,
col1 VARCHAR(50),
col2 INT,
col3 VARCHAR(50)
) ENGINE=KVT;
INSERT INTO t6 VALUES (1, 'a', 10, 'x'), (2, 'b', 20, 'y'), (3, 'c', 30, 'z');
# Multiple operations in single ALTER
ALTER TABLE t6 
ADD COLUMN col4 INT DEFAULT 0,
DROP COLUMN col3,
MODIFY COLUMN col1 VARCHAR(100),
ADD INDEX idx_col2 (col2);
DESC t6;
Field	Type	Null	Key	Default	Extra
id	int(11)	NO	PRI	NULL	
col1	varchar(100)	YES		NULL	
col2	int(11)	YES	MUL	NULL	
col4	int(11)	YES		0	
SHOW CREATE TABLE t6;
Table	Create Table
t6	CREATE TABLE `t6` (
  `id` int(11) NOT NULL,
  `col1` varchar(100) DEFAULT NULL,
  `col2` int(11) DEFAULT NULL,
  `col4` int(11) DEFAULT 0,
  PRIMARY KEY (`id`),
  KEY `idx_col2` (`col2`)
) ENGINE=KVT DEFAULT CHARSET=latin1
# ========================================
# Test 6: ALTER TABLE with NULL/NOT NULL
# ========================================
CREATE TABLE t7 (
id INT PRIMARY KEY,
nullable_col INT,
non_null_col INT NOT NULL
) ENGINE=KVT;
INSERT INTO t7 VALUES (1, NULL, 100), (2, 200, 200), (3, NULL, 300);
# Change nullable to NOT NULL (should fail with NULL values)
ALTER TABLE t7 MODIFY COLUMN nullable_col INT NOT NULL;
ERROR 22004: Invalid use of NULL value
# Update NULL values first
UPDATE t7 SET nullable_col = 0 WHERE nullable_col IS NULL;
# Now change to NOT NULL
ALTER TABLE t7 MODIFY COLUMN nullable_col INT NOT NULL;
DESC t7;
Field	Type	Null	Key	Default	Extra
id	int(11)	NO	PRI	NULL	
nullable_col	int(11)	NO		NULL	
non_null_col	int(11)	NO		NULL	
# Change NOT NULL to nullable
ALTER TABLE t7 MODIFY COLUMN non_null_col INT;
DESC t7;
Field	Type	Null	Key	Default	Extra
id	int(11)	NO	PRI	NULL	
nullable_col	int(11)	NO		NULL	
non_null_col	int(11)	YES		NULL	
# ========================================
# Test 7: ALTER TABLE with Data Type Changes
# ========================================
CREATE TABLE t8 (
id INT PRIMARY KEY,
int_col INT,
varchar_col VARCHAR(50),
decimal_col DECIMAL(10,2)
) ENGINE=KVT;
INSERT INTO t8 VALUES (1, 100, '200', 300.50), (2, 400, '500', 600.75);
# Widen INT to BIGINT (safe conversion)
ALTER TABLE t8 MODIFY COLUMN int_col BIGINT;
DESC t8;
Field	Type	Null	Key	Default	Extra
id	int(11)	NO	PRI	NULL	
int_col	bigint(20)	YES		NULL	
varchar_col	varchar(50)	YES		NULL	
decimal_col	decimal(10,2)	YES		NULL	
SELECT * FROM t8;
id	int_col	varchar_col	decimal_col
1	100	200	300.50
2	400	500	600.75
# Increase VARCHAR length (safe conversion)
ALTER TABLE t8 MODIFY COLUMN varchar_col VARCHAR(100);
DESC t8;
Field	Type	Null	Key	Default	Extra
id	int(11)	NO	PRI	NULL	
int_col	bigint(20)	YES		NULL	
varchar_col	varchar(100)	YES		NULL	
decimal_col	decimal(10,2)	YES		NULL	
# Change DECIMAL precision
ALTER TABLE t8 MODIFY COLUMN decimal_col DECIMAL(15,3);
DESC t8;
Field	Type	Null	Key	Default	Extra
id	int(11)	NO	PRI	NULL	
int_col	bigint(20)	YES		NULL	
varchar_col	varchar(100)	YES		NULL	
decimal_col	decimal(15,3)	YES		NULL	
SELECT * FROM t8;
id	int_col	varchar_col	decimal_col
1	100	200	300.500
2	400	500	600.750
# ========================================
# Test 8: RENAME TABLE
# ========================================
CREATE TABLE t9 (id INT PRIMARY KEY, data VARCHAR(50)) ENGINE=KVT;
INSERT INTO t9 VALUES (1, 'test');
ALTER TABLE t9 RENAME TO t9_renamed;
SELECT * FROM t9;
ERROR 42S02: Table 'test.t9' doesn't exist
SELECT * FROM t9_renamed;
id	data
1	test
ALTER TABLE t9_renamed RENAME TO t9;
SELECT * FROM t9;
id	data
1	test
# ========================================
# Test 9: ALTER TABLE Error Handling
# ========================================
CREATE TABLE t10 (
id INT PRIMARY KEY,
unique_col INT UNIQUE,
data VARCHAR(50)
) ENGINE=KVT;
INSERT INTO t10 VALUES (1, 100, 'data1'), (2, 200, 'data2');
# Test duplicate key error
INSERT INTO t10 VALUES (3, 100, 'data3');
ERROR 23000: Duplicate entry '100' for key 'unique_col'
# Test invalid column reference
ALTER TABLE t10 ADD INDEX idx_invalid (non_existent_col);
ERROR 42000: Key column 'non_existent_col' doesn't exist in table
# Test conflicting constraints
# ========================================
# Test 10: Performance of ALTER Operations
# ========================================
CREATE TABLE t_perf (
id INT PRIMARY KEY,
col1 INT,
col2 VARCHAR(100)
) ENGINE=KVT;
CREATE PROCEDURE insert_many()
BEGIN
DECLARE i INT DEFAULT 1;
WHILE i <= 1000 DO
INSERT INTO t_perf VALUES (i, i * 10, CONCAT('data', i));
SET i = i + 1;
END WHILE;
END//
CALL insert_many();
# Test ALTER on large table
SELECT COUNT(*) FROM t_perf;
COUNT(*)
1000
SET @start_time = NOW(6);
ALTER TABLE t_perf ADD COLUMN col3 INT DEFAULT 0;
SET @end_time = NOW(6);
SELECT TIMESTAMPDIFF(MICROSECOND, @start_time, @end_time) AS alter_time_microseconds;
alter_time_microseconds
<ALTER_TIME>
SELECT COUNT(*) FROM t_perf WHERE col3 = 0;
COUNT(*)
1000
DROP PROCEDURE insert_many;
# ========================================
# Cleanup
# ========================================
DROP TABLE IF EXISTS t1, t2, t3, t4, t5, t6, t7, t8, t9, t10, t_perf;