#
# Test basic condition pushdown optimization
#
# Create database and use it
CREATE DATABASE IF NOT EXISTS test_kvt_pushdown;
USE test_kvt_pushdown;
#
# Test 1: Simple equality conditions
#
CREATE TABLE t1 (
id INT PRIMARY KEY,
name VARCHAR(50),
age INT,
city VARCHAR(50)
) ENGINE=KVT;
INSERT INTO t1 VALUES 
(1, 'Alice', 25, 'New York'),
(2, 'Bob', 30, 'London'),
(3, 'Charlie', 35, 'Paris'),
(4, 'David', 28, 'Tokyo'),
(5, 'Eve', 32, 'Sydney');
# Simple equality pushdown
SELECT * FROM t1 WHERE id = 3;
id	name	age	city
3	Charlie	35	Paris
SELECT * FROM t1 WHERE name = 'Bob';
id	name	age	city
2	Bob	30	London
SELECT * FROM t1 WHERE age = 30;
id	name	age	city
2	Bob	30	London
SELECT * FROM t1 WHERE city = 'Paris';
id	name	age	city
3	Charlie	35	Paris
# Multiple conditions with AND
SELECT * FROM t1 WHERE age > 25 AND city = 'London';
id	name	age	city
2	Bob	30	London
SELECT * FROM t1 WHERE id >= 2 AND id <= 4;
id	name	age	city
2	Bob	30	London
3	Charlie	35	Paris
4	David	28	Tokyo
DROP TABLE t1;
#
# Test 2: Comparison operators
#
CREATE TABLE t2 (
id INT PRIMARY KEY,
value INT,
score DECIMAL(5,2)
) ENGINE=KVT;
INSERT INTO t2 VALUES 
(1, 100, 85.50),
(2, 200, 92.75),
(3, 150, 78.25),
(4, 300, 95.00),
(5, 250, 88.50);
# Less than
SELECT * FROM t2 WHERE value < 200;
id	value	score
1	100	85.50
3	150	78.25
# Greater than
SELECT * FROM t2 WHERE score > 90.00;
id	value	score
2	200	92.75
4	300	95.00
# Less than or equal
SELECT * FROM t2 WHERE value <= 150;
id	value	score
1	100	85.50
3	150	78.25
# Greater than or equal
SELECT * FROM t2 WHERE score >= 85.00;
id	value	score
1	100	85.50
2	200	92.75
4	300	95.00
5	250	88.50
# Not equal
SELECT * FROM t2 WHERE value != 200;
id	value	score
1	100	85.50
3	150	78.25
4	300	95.00
5	250	88.50
DROP TABLE t2;
#
# Test 3: NULL handling
#
CREATE TABLE t3 (
id INT PRIMARY KEY,
nullable_col VARCHAR(50),
value INT
) ENGINE=KVT;
INSERT INTO t3 VALUES 
(1, 'data1', 100),
(2, NULL, 200),
(3, 'data3', NULL),
(4, NULL, NULL),
(5, 'data5', 500);
# IS NULL condition
SELECT * FROM t3 WHERE nullable_col IS NULL;
id	nullable_col	value
2	NULL	200
4	NULL	NULL
SELECT * FROM t3 WHERE value IS NULL;
id	nullable_col	value
3	data3	NULL
4	NULL	NULL
# IS NOT NULL condition
SELECT * FROM t3 WHERE nullable_col IS NOT NULL;
id	nullable_col	value
1	data1	100
3	data3	NULL
5	data5	500
SELECT * FROM t3 WHERE value IS NOT NULL;
id	nullable_col	value
1	data1	100
2	NULL	200
5	data5	500
# Combination with other conditions
SELECT * FROM t3 WHERE nullable_col IS NOT NULL AND value > 100;
id	nullable_col	value
5	data5	500
DROP TABLE t3;
#
# Test 4: Type conversion in conditions
#
CREATE TABLE t4 (
id INT PRIMARY KEY,
int_col INT,
str_col VARCHAR(50),
date_col DATE
) ENGINE=KVT;
INSERT INTO t4 VALUES 
(1, 100, '100', '2024-01-01'),
(2, 200, '200', '2024-02-01'),
(3, 300, '300', '2024-03-01');
# Numeric comparison with string column
SELECT * FROM t4 WHERE str_col = '200';
id	int_col	str_col	date_col
2	200	200	2024-02-01
# String comparison with numeric column
SELECT * FROM t4 WHERE int_col = 200;
id	int_col	str_col	date_col
2	200	200	2024-02-01
# Date comparisons
SELECT * FROM t4 WHERE date_col > '2024-01-15';
id	int_col	str_col	date_col
2	200	200	2024-02-01
3	300	300	2024-03-01
SELECT * FROM t4 WHERE date_col BETWEEN '2024-01-01' AND '2024-02-28';
id	int_col	str_col	date_col
1	100	100	2024-01-01
2	200	200	2024-02-01
DROP TABLE t4;
#
# Test 5: Complex conditions (AND/OR)
#
CREATE TABLE t5 (
id INT PRIMARY KEY,
category VARCHAR(20),
status VARCHAR(20),
priority INT
) ENGINE=KVT;
INSERT INTO t5 VALUES 
(1, 'A', 'active', 1),
(2, 'B', 'inactive', 2),
(3, 'A', 'active', 3),
(4, 'C', 'pending', 1),
(5, 'B', 'active', 2);
# AND conditions
SELECT * FROM t5 WHERE category = 'A' AND status = 'active';
id	category	status	priority
1	A	active	1
3	A	active	3
SELECT * FROM t5 WHERE priority > 1 AND status != 'inactive';
id	category	status	priority
3	A	active	3
5	B	active	2
# OR conditions (may not push down)
SELECT * FROM t5 WHERE category = 'A' OR category = 'B';
id	category	status	priority
1	A	active	1
2	B	inactive	2
3	A	active	3
5	B	active	2
SELECT * FROM t5 WHERE status = 'active' OR priority = 1;
id	category	status	priority
1	A	active	1
3	A	active	3
4	C	pending	1
5	B	active	2
# Mixed AND/OR
SELECT * FROM t5 WHERE (category = 'A' OR category = 'B') AND status = 'active';
id	category	status	priority
1	A	active	1
3	A	active	3
5	B	active	2
DROP TABLE t5;
# Cleanup
DROP DATABASE test_kvt_pushdown;